<%= form_with(model: profile) do |form| %>
  <% if profile.errors.any? %>
    <div style="color: #ffb3c1">
      <h2><%= pluralize(profile.errors.count, "error") %> prohibited this profile from being saved:</h2>
      <ul>
        <% profile.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :bio %>
    <%= form.textarea :bio %>
  </div>

  <div>
    <%= form.label :role %>
    <%= form.select :role, Profile.roles.keys.map { |role| [ role.humanize, role ] }, { prompt: "Select a role" }, required: true %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
