<%= render @profile %>

<div class="page-actions">
  <% if current_user == @profile.user %>
    <%= link_to "Edit", edit_profile_path(@profile), class: "button" %>
    <%= button_to "Delete", @profile, method: :delete %>
  <% end %>
  <%= link_to "Back", profiles_path, class: "button button--ghost" %>
</div>
